{
  "manifest_version": 2,
  "name": "Zotvim",
  "version": "0.3.0",
  "description": "Navigate Zotero's library and PDF viewer with Vim keys. No modes, no extra processes.",
  "applications": {
    "zotero": {
      "id": "zotvim@zotvim.local",
